+  async getReadStatusesForIds(userId: number, ids: number[], isSuperuser = false, contentFilters?: ContentFilterRules) {
+    if (!ids.length) return [];
+    const scope = await this.buildCatalogScope(userId, { ids }, isSuperuser, contentFilters);
+    if (!scope) return [];
+    return this.db
+      .select({ id: books.id, status: userBookStatus.status, updatedAt: userBookStatus.updatedAt, finishedAt: userBookStatus.finishedAt })
+      .from(books)
+      .leftJoin(bookMetadata, eq(bookMetadata.bookId, books.id))
+      .innerJoin(userBookStatus, and(eq(userBookStatus.bookId, books.id), eq(userBookStatus.userId, userId)))
+      .where(scope.where)
+      .orderBy(books.id)
+      .limit(200);
+  }
