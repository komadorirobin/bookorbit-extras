@@ -0,0 +1,26 @@
+import 'reflect-metadata';
+import { ValidationPipe } from '@nestjs/common';
+import { KoreaderReadStatusesQueryDto } from './koreader-read-statuses-query.dto';
+
+describe('KoreaderReadStatusesQueryDto', () => {
+  const pipe = new ValidationPipe({ transform: true, whitelist: true, forbidNonWhitelisted: true });
+  const meta = { type: 'query' as const, metatype: KoreaderReadStatusesQueryDto };
+  it('requires a bounded explicit device ID batch', async () => {
+    await expect(pipe.transform({ ids: '2,17' }, meta)).resolves.toEqual({ ids: [2, 17] });
+    await expect(pipe.transform({ ids: Array.from({ length: 200 }, (_, i) => i + 1).join(',') }, meta)).resolves.toBeDefined();
+  });
+  it.each([
+    {},
+    { ids: '' },
+    { ids: '1,no' },
+    { ids: '0' },
+    { ids: '-1' },
+    { ids: '1.2' },
+    { ids: '9007199254740992' },
+    { ids: Array.from({ length: 201 }, (_, i) => i + 1).join(',') },
+    { ids: '1', userId: 2 },
+    { ids: '1', q: 'all' },
+  ])('rejects unbounded or malformed inputs: %j', async (input) => {
+    await expect(pipe.transform(input, meta)).rejects.toThrow();
+  });
+});
diff --git a/server/src/modules/koreader/dto/koreader-read-statuses-query.dto.ts b/server/src/modules/koreader/dto/koreader-read-statuses-query.dto.ts
new file mode 100644
index 00000000..cde906e6
--- /dev/null
+++ b/server/src/modules/koreader/dto/koreader-read-statuses-query.dto.ts
@@ -0,0 +1,13 @@
+import { Transform } from 'class-transformer';
+import { ArrayMaxSize, ArrayMinSize, IsArray, IsInt, Max, Min } from 'class-validator';
+
+export class KoreaderReadStatusesQueryDto {
+  @Transform(({ value }) => (typeof value === 'string' ? value.split(',').map((part: string) => (/^\d+$/.test(part) ? Number(part) : NaN)) : value))
+  @IsArray()
+  @ArrayMinSize(1)
+  @ArrayMaxSize(200)
+  @IsInt({ each: true })
+  @Min(1, { each: true })
+  @Max(Number.MAX_SAFE_INTEGER, { each: true })
+  ids!: number[];
+}
