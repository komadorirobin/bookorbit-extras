+  async getBookIdsWithTag(userId: number, ids: number[], tag: string, isSuperuser = false, contentFilters?: ContentFilterRules): Promise<number[]> {
+    if (!ids.length) return [];
+    const scope = await this.buildCatalogScope(userId, { ids }, isSuperuser, contentFilters);
+    if (!scope) return [];
+    const membership = this.db
+      .select({ one: sql`1` })
+      .from(bookTags)
+      .innerJoin(tags, eq(tags.id, bookTags.tagId))
+      .where(and(eq(bookTags.bookId, books.id), eq(tags.name, tag)));
+    const rows = await this.db
+      .select({ id: books.id })
+      .from(books)
+      .leftJoin(bookMetadata, eq(bookMetadata.bookId, books.id))
+      .where(and(scope.where, exists(membership)))
+      .orderBy(books.id)
+      .limit(200);
+    return rows.map((row) => row.id);
+  }
